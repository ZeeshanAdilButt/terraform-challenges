# This month's configuration. Two things changed since the last apply:
#   1. local_file.notes was renamed to local_file.readme (same file, same content).
#   2. local_file.legacy was removed from the configuration. Another team still reads that file,
#      so it must stay on disk. Terraform just must stop managing it.
# Do not edit this file. Fix the state, in commands.txt.
terraform {
  required_providers {
    local = {
      source  = "hashicorp/local"
      version = "~> 2.9"
    }
  }
}

resource "local_file" "readme" {
  filename = "${path.module}/out/notes.txt"
  content  = "team notes\n"
}

resource "terraform_data" "build" {
  input = "build-1"
}
