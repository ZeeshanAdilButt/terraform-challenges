# Two secrets, two ways in. Do not edit this file: the task is in predictions.json.
#   db_password  comes in as a sensitive input variable (run.mjs passes a made-up demo value).
#   random_password.api  is made by Terraform itself during the apply.
terraform {
  required_providers {
    random = {
      source  = "hashicorp/random"
      version = "~> 3.9"
    }
  }
}

variable "db_password" {
  type      = string
  sensitive = true
}

resource "random_password" "api" {
  length  = 16
  special = false
}

resource "terraform_data" "db" {
  input = var.db_password
}

resource "terraform_data" "api" {
  input = random_password.api.result
}

output "api_token" {
  value     = random_password.api.result
  sensitive = true
}
