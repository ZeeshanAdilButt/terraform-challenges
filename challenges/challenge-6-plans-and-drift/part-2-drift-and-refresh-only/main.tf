# One labelled container and one small record. Do not edit this file: the task is in drift.mjs.
terraform {
  required_providers {
    docker = {
      source  = "kreuzwerker/docker"
      version = "~> 4.6"
    }
  }
}

provider "docker" {}

resource "docker_container" "app" {
  name        = "tfc-c6-app"
  image       = "alpine:3.23"
  command     = ["sleep", "600"]
  memory      = 64
  memory_swap = 64

  labels {
    label = "tfc.challenge"
    value = "6"
  }
}

resource "terraform_data" "note" {
  input = "release 1"
}
