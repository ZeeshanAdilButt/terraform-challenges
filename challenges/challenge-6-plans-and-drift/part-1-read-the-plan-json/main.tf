# The pull request. Do not edit this file: the task is in classify.mjs.
# Compared with before/main.tf:
#   web      the image changes from nginx to alpine
#   worker   the memory limit goes from 64 to 96
#   motd     the text of the file changes
#   old      is deleted from the code
#   newcomer is new
#   same     is untouched
#   cbd      its trigger changes, and it is built before the old one is removed
terraform {
  required_providers {
    docker = {
      source  = "kreuzwerker/docker"
      version = "~> 4.6"
    }
    local = {
      source  = "hashicorp/local"
      version = "~> 2.9"
    }
  }
}

provider "docker" {}

resource "docker_container" "web" {
  name        = "tfc-c6-web"
  image       = "alpine:3.23"
  command     = ["sleep", "600"]
  memory      = 64
  memory_swap = 64

  labels {
    label = "tfc.challenge"
    value = "6"
  }
}

resource "docker_container" "worker" {
  name        = "tfc-c6-worker"
  image       = "alpine:3.23"
  command     = ["sleep", "600"]
  memory      = 96
  memory_swap = 96

  labels {
    label = "tfc.challenge"
    value = "6"
  }
}

resource "local_file" "motd" {
  filename = "${path.module}/out/motd.txt"
  content  = "welcome back\n"
}

resource "terraform_data" "newcomer" {
  input = "a new job"
}

resource "terraform_data" "same" {
  input = "unchanged"
}

resource "terraform_data" "cbd" {
  triggers_replace = "v2"

  lifecycle {
    create_before_destroy = true
  }
}
